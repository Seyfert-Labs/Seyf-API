# Copiar a .env y completar. NUNCA commitear .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Auth de la SEYF API
# Genera uno real con: openssl rand -base64 48
AUTH_JWT_SECRET=
# Verificación de identidad Privy (dashboard → App settings)
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# Supabase (service role: solo servidor, omite RLS — jamás en un cliente).
# Sin credenciales en dev, los repositorios usan memoria (se pierde al reiniciar);
# en producción son obligatorias.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bóvedas DeFindex / red Stellar
STELLAR_NETWORK=testnet
# API key sk_... — opcional en testnet para lecturas, requerida para escrituras
DEFINDEX_API_KEY=
# Direcciones de VAULT (no de estrategia). Sin valor se usan las de paltalabs.
# DEFINDEX_VAULT_XLM=
# DEFINDEX_VAULT_CETES=
# DEFINDEX_VAULT_USDC=

# Verificación de identidad (Etherfuse)
ETHERFUSE_API_KEY=
# Secreto del webhook en base64. Sin él, /v1/webhooks/etherfuse responde 503:
# nunca se acepta un evento sin verificar su firma.
ETHERFUSE_WEBHOOK_SECRET=
# ETHERFUSE_BASE_URL=https://devnet.blockchain.etherfuse.com

# Secretos de integraciones (se agregan al portar cada módulo desde SEYF-P):
# POLLAR_API_URL=
# BITSO_API_KEY=
# BITSO_API_SECRET=
# STELLAR_NETWORK=testnet
