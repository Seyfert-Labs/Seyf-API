{
  "name": "seyf-api",
  "version": "0.1.0",
  "private": true,
  "description": "SEYF API — backend de producto para los clientes web y móvil de SEYF",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@defindex/sdk": "^0.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@supabase/supabase-js": "^2.111.0",
    "canonicalize": "^3.0.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^5.0.0",
    "jose": "^6.2.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
